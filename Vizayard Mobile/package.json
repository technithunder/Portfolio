{
  "name": "VizaYard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator='iPhone13'",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "font": "npx react-native-asset",
    "android_build": "cd android && ./gradlew assembleRelease",
    "clean": "cd android && ./gradlew clean && cd ../",
    "sha1": "cd android && ./gradlew signingReport",
    "connect": "scrcpy --select-tcpip",
    "pod": "cd ios && pod install --repo-update && cd ../",
    "bundle-android": "react-native bundle --entry-file index.js  --platform android --dev false --bundle-output ./android/app/src/main/assets/index.android.bundle --assets-dest ./android/app/src/main/res",
    "remove_node": "rm -rf node_modules && rm -f package-lock.json && rm -f yarn.lock",
    "remove_pod": "cd ios && rm -rf Pods && rm -f Podfile.lock",
    "remove_all": "npm run remove_node && npm run remove_pod",
    "xc": "xed -b ios",
    "remove_duplicate": "rm -rf ./android/app/src/main/res/drawable-* && rm -rf ./android/app/src/main/res/raw",
    "open_as": "open /path/to/AndroidStudio.app",
    "build_ios": "react-native bundle --entry-file='index.js' --bundle-output='./ios/main.jsbundle' --dev=false --platform='ios'",
    "postinstall": "patch-package",
    "side-effects": "yarn run pod;",
    "postuninstall": "npm run side-effects"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.1.5",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "^8.3.0",
    "@react-native-firebase/app": "21.10.1",
    "@react-native-firebase/messaging": "21.10.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native/gradle-plugin": "^0.77.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@reduxjs/toolkit": "^2.6.1",
    "@shopify/flash-list": "^1.8.0",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "deprecated-react-native-prop-types": "^5.0.0",
    "formik": "^2.4.6",
    "install": "^0.13.0",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "npm": "^11.4.1",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-calendar-strip": "^2.2.6",
    "react-native-document-picker": "^9.3.1",
    "react-native-document-scanner-plugin": "^1.0.1",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-fast-image": "^8.6.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.22.1",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-image-picker": "^7.2.3",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-otp-entry": "^1.8.2",
    "react-native-permissions": "^5.3.0",
    "react-native-raw-bottom-sheet": "^3.0.0",
    "react-native-razorpay": "^2.3.0",
    "react-native-reanimated": "^3.16.7",
    "react-native-reanimated-carousel": "^4.0.2",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "4.4.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-snap-carousel": "^3.9.1",
    "react-native-step-indicator": "^1.0.3",
    "react-native-svg": "^15.11.1",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-toast-message": "^2.2.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-vision-camera": "^4.6.3",
    "react-native-webview": "^13.15.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "rn-fetch-blob": "^0.12.0",
    "yup": "^1.6.1"
