{
  "name": "VirtualLight",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "lint": "eslint .",
    "start": "react-native start",
    "reset": "react-native start --resetCache",
    "test": "jest",
    "font": "npx react-native-asset",
    "android_build": "cd android && ./gradlew assembleRelease",
    "clean": "cd android && ./gradlew clean && cd ../",
    "sha1": "cd android && ./gradlew signingReport",
    "connect": "scrcpy --select-tcpip",
    "pod": "cd ios && pod install --repo-update && cd ../",
    "ios": "npx react-native run-ios --simulator 'iPhone13'",
    "bundle-android": "react-native bundle --entry-file index.js  --platform android --dev false --bundle-output ./android/app/src/main/assets/index.android.bundle --assets-dest ./android/app/src/main/res",
    "remove_node": "rm -rf node_modules && rm -f package-lock.json && rm -f yarn.lock",
    "remove_pod": "cd ios && rm -rf Pods && rm -f Podfile.lock",
    "remove_all": "npm run remove_node && npm run remove_pod",
    "xc": "xed -b ios",
    "remove_duplicate": "rm -rf ./android/app/src/main/res/drawable-* && rm -rf ./android/app/src/main/res/raw",
    "open:android": "open -a Android ./android",
    "build_ios": "react-native bundle --entry-file='index.js' --bundle-output='./ios/main.jsbundle' --dev=false --platform='ios'",
    "remove_git": "rm -rf .git",
    "side-effects": "yarn run pod;",
    "postinstall": "patch-package",
    "postuninstall": "npm run side-effects"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "^8.4.1",
    "@react-native-firebase/app": "^22.4.0",
    "@react-native-firebase/messaging": "^22.2.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/drawer": "^7.3.11",
    "@react-navigation/native": "^7.1.5",
    "@react-navigation/stack": "^7.2.9",
    "@reduxjs/toolkit": "^2.6.1",
    "axios": "^1.9.0",
    "formik": "^2.4.6",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react": "19.0.0",
    "react-native": "0.78.2",
    "react-native-actions-sheet": "^0.9.7",
    "react-native-color-picker": "^0.6.0",
    "react-native-date-picker": "^5.0.13",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-fast-image": "^8.6.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.25.0",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-image-crop-picker": "^0.42.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-controller": "^1.18.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-otp-entry": "^1.8.4",
    "react-native-permissions": "^5.3.0",
    "react-native-reanimated": "^3.17.3",
    "react-native-reanimated-carousel": "^4.0.2",
    "react-native-safe-area-context": "^5.3.0",
    "react-native-screens": "^4.10.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-swipe-list-view": "^3.2.9",
    "react-native-toast-message": "^2.3.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-wheel-color-picker": "^1.3.1",
    "react-redux": "^9.2.0",
    "reactotron-react-native": "^5.1.13",
    "reanimated-color-picker": "^4.1.0",
    "redux-persist": "^6.0.0",
    "rn-material-ui-textfield": "^1.0.9",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.2",
    "@react-native/eslint-config": "0.78.2",
    "@react-native/metro-config": "0.78.2",
    "@react-native/typescript-config": "0.78.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
